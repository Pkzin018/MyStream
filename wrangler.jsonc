{
  "name": "mystream-eopkzin",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"directory": "artifacts/mystream/dist/public", "binding": "ASSETS", "run_worker_first": ["/api/*"], "not_found_handling": "single-page-application"},
  "ratelimits": [{"name": "SEARCH_LIMITER", "namespace_id": "1001", "simple": {"limit": 10, "period": 60}}],
  "observability": {"enabled": true, "head_sampling_rate": 0.1}
}
